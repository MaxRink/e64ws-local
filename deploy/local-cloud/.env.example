# local-cloud environment — copy to .env and edit.
#
#   cp .env.example .env
#   chmod 600 .env
#   # fill in the empty values below with fresh random ones:
#   #   openssl rand -hex 32
#
# `.env` is git-ignored (.gitignore).  Nothing committed here is a credential:
# every credential below is *empty* on purpose, and no value in this file is a
# real token, password or key (docs/LOCAL_CLOUD_DESIGN.md §8).
#
# Why empty instead of a placeholder
# ----------------------------------
# This file used to ship a ready-made owner token (a "replace-me" string with a
# suffix).  That is not a placeholder to the service: it is a token.  Copying
# the file and running `docker compose up` (or `python3 -m
# tools.local_cloud.service`) produced a stack whose admin API answered an
# anonymous caller holding the published string.  An empty token makes the admin
# API answer `403 admin-not-configured` instead, which is the fail-closed
# default the code already implements (tools/local_cloud/service.py).
#
# The same reasoning applies to POSTGRES_PASSWORD: PostgreSQL accepts a
# placeholder as a password, so the template profile refuses to start while it
# is empty (docker-compose.templates.yml interpolates it as a required
# variable).
#
# The service reads these names directly (tools/local_cloud/service.py), so the
# same file drives `docker compose up` and a bare `python3 -m`.  It is no longer
# a *working* deployment on its own: the token is empty, the listener is
# loopback, and the two paths under /var/lib/local-cloud only exist inside the
# container - point LOCAL_CLOUD_DB and LOCAL_CLOUD_AUDIT_FILE at a writable
# directory for a bare run.

# --- service ---------------------------------------------------------------
# Owner token for /admin/v1/*.  EMPTY = the admin API is disabled and answers
# 403 admin-not-configured.  Set it to a fresh `openssl rand -hex 32` value to
# enable the admin API; never reuse a real password.
LOCAL_CLOUD_ADMIN_TOKEN=

# Listener.  127.0.0.1 is right for a bare `python3 -m tools.local_cloud.service`
# on the host: nothing on the LAN can reach it.  The container bind is set by
# docker-compose.yml (`LOCAL_CLOUD_HOST: "0.0.0.0"`), because inside the
# container the proxy has to reach it over the `internal` network - and that
# network publishes no port, so a container listener on 0.0.0.0 is still not
# reachable from the host or the LAN.
LOCAL_CLOUD_HOST=127.0.0.1
LOCAL_CLOUD_PORT=8080

# State and audit mirror.  Both live on the apidata volume.
# The audit file is append-only by convention, flushed and fsynced per line -
# but it is written by the same process that serves the API, so it is not
# tamper-evident (docs/LOCAL_CLOUD_DESIGN.md §8).
LOCAL_CLOUD_DB=/var/lib/local-cloud/local-cloud.sqlite3
LOCAL_CLOUD_AUDIT_FILE=/var/lib/local-cloud/audit.jsonl

# TRUST_PROXY_IDENTITY is OFF unless you turn it on, and that is not a
# formality: when it is on, the API believes the X-Client-Cert-Fingerprint
# request header, so *whatever* can reach the listener can claim to be any
# enrolled device.  Only enable it when the API is reachable from the edge proxy
# alone (the compose default: `internal` network, no published port) and only
# when that edge overwrites the header from the real handshake - which the device
# vhost in Caddyfile does and Caddyfile.offline deliberately does not (it
# deletes the header instead).
#
# Enable it (by uncommenting the line below in your own .env, never here) and
# remember that the flag plus a reachable listener is an authentication bypass:
#
# LOCAL_CLOUD_TRUST_PROXY_IDENTITY=true

# Development escape hatch: attribute every request to one seeded device.
# Never true on a host a real grinder can reach.
LOCAL_CLOUD_ALLOW_ANONYMOUS=false
LOCAL_CLOUD_DEV_DEVICE_ID=local-dev-device

# `downloadUrl` base for D07.  Only used once an artifact is admitted.
LOCAL_CLOUD_ARTIFACT_BASE_URL=http://localhost:8088/firmware

# --- edge bind (compose interpolation, not read by the service) -------------
# The default edge publishes 8088/8443 on 127.0.0.1.  Set this to 0.0.0.0 for a
# device test from the LAN:
#
#   LOCAL_CLOUD_EDGE_BIND=0.0.0.0 docker compose up -d proxy
#
# It publishes an unauthenticated plain-HTTP edge and a `tls internal` sibling
# whose CA nothing trusts to every host on the segment, so the default stays
# loopback.  See the `proxy` service in docker-compose.yml.
# LOCAL_CLOUD_EDGE_BIND=0.0.0.0

# --- direct mutual TLS (alternative to the proxy) --------------------------
# Point these at the files created by deploy/local-cloud/gen-dev-certs.sh, or at
# your own owner CA material.  Leave empty when the proxy terminates TLS.
LOCAL_CLOUD_TLS_CERT=
LOCAL_CLOUD_TLS_KEY=
LOCAL_CLOUD_CLIENT_CA=
# Requiring a client certificate also applies to the admin routes on the same
# listener; that is why the default is false and the device routes refuse an
# anonymous request on their own.
LOCAL_CLOUD_REQUIRE_CLIENT_CERT=false

# --- PostgreSQL template (not used by the service yet) ---------------------
# docs/LOCAL_CLOUD_DESIGN.md §4 targets PostgreSQL; the skeleton serves from
# SQLite.  These values only matter for the `db` service, which lives in
# docker-compose.templates.yml and **refuses to start while POSTGRES_PASSWORD is
# empty**: the compose file interpolates it as a required variable.  That is
# deliberate - the old default was a placeholder string, which the server
# accepts as a password.
#
# `db` is postgres:18 and mounts pgdata at /var/lib/postgresql - the 18 layout,
# where the cluster lives in 18/docker.  A pgdata volume written by 16 stores
# the cluster at its root and will NOT be picked up: 18 exits 1 on it.  Dump and
# restore before switching an old volume over - see "Upgrading from 16" in
# README.md.
POSTGRES_DB=localcloud
POSTGRES_USER=localcloud
POSTGRES_PASSWORD=

# --- object store (not used by the service yet, and not started) ------------
# There is no `objects` service: no pullable MinIO server image exists, so the
# template was removed rather than left on a dead tag (README.md "Object
# store").  These names stay for the design's §4 wiring; nothing reads them, and
# nothing here should be pointed at a bucket until an image is chosen, pinned by
# digest, licensed for the operations you need, and given a healthcheck that
# exercises an S3 call rather than only the liveness probe.
#
# Empty for the same reason as the token above: a value here is a credential the
# day something does read it, and no service today refuses to start on a
# placeholder because no service reads them at all.
S3_BUCKET=local-cloud
S3_ACCESS_KEY=
S3_SECRET_KEY=
