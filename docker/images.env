# Pinned base images for every target under docker/.
#
# One KEY=VALUE line per base image, in the form repository:tag@sha256:<digest>.
# The digest is always the manifest-list (multi-arch) digest, so the same pin
# resolves to the right per-platform image on arm64 and amd64 hosts.
#
# This file is deliberately the single source of the pins:
#   * verify.sh sources it as a shell fragment;
#   * compose.yaml interpolates the same names, so it must be run with
#     `docker compose --env-file docker/images.env`.
#
# Verification status per line is recorded next to it.  "pulled" means the
# digest was read from the local image's RepoDigests after `docker pull`, i.e.
# the digest the daemon actually resolved on 2026-11-25.  "index" means the
# digest was read from the registry manifest index with
# `docker buildx imagetools inspect` and the image was never pulled; the value
# is the registry's own statement about the tag, not a local measurement.
#
# Nothing here pins a Debian package version: the apt layers above these bases
# resolve against the live archive, so the derived images are reproducible in
# behaviour, not bit for bit.  See docs/REPRODUCIBLE_BUILDS.md.

# pulled  (Python 3.11.18, Debian 13.8 slim)
PYTHON_311=python:3.11-slim@sha256:61e01f72680f86a5279ad510818ab7b2ee9f049822589d4e34e33e044360356c

# pulled  (Python 3.13.18, Debian 13.8 slim)
PYTHON_313=python:3.13-slim@sha256:7249d5587b78209a006dc4a3b5340678f84ea729239193aa559962cd8c1fce50

# pulled  (Python 3.15.2, Debian 13.8 slim; the same version as the local interpreter)
PYTHON_315=python:3.15-slim@sha256:63bb298d2b7b88f176f51b5189f54ce6535c997682ea70885d2132f5d473a8a5

# pulled  (PHP 8.4.28, ships php-cgi and pdo_sqlite/sqlite3)
PHP_84=php:8.4-cli@sha256:d9375942df6f191e43650a7ea7274e775f9a4526f9995ce90676f5330b5f51e6

# pulled  (Debian 12 bookworm; the base has no python3, the Dockerfile adds it)
DEBIAN_BOOKWORM=debian:bookworm-slim@sha256:e67eeead736ff7bbe258ef088bff683635c561b1fcfefad0806c1df4ab49ce0e

# pulled  (Node 26.13.1, matching the host interpreter)
NODE_26=node:26-slim@sha256:abe7e5a82b61a8ef67b315b85497c9e65173387ccf2f4a029248184b8e020be5

# index   (JDK 21; the digest is an index reading. The image has since been
#          pulled as the base of the android build -- six layers, 2026-11-26,
#          see docs/REPRODUCIBLE_BUILDS.md section 6)
TEMURIN_21=eclipse-temurin:21-jdk@sha256:8ad118b146aa92da815b576441acd6b42b38236797ad0b6edc8c200b85bb0734

# index   (Swift 6.3; never pulled, iOS is Dockerfile-only)
SWIFT_63=swift:6.3-noble@sha256:4f42306306fe7e5a773a8d47d7e2a24dc3a975d1feb77996297ecfd7c329b1e9
