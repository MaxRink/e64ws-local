{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-supported Mahlkoenig Android account-gate patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["input_libapp_sha256", "status", "patches"],
  "properties": {
    "input_libapp_sha256": {
      "const": "66f08f1b88c9431b665166b7eb14808ef68ebc9131fd1c655cd4a48e836a0c8c"
    },
    "status": {"const": "evidence_supported"},
    "patches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "offset",
          "expected_hex",
          "replacement_hex",
          "confidence",
          "evidence"
        ],
        "properties": {
          "purpose": {"enum": ["account_gate", "account_state_dependency"]},
          "offset": {"type": ["integer", "string"]},
          "expected_hex": {"type": "string", "pattern": "^[0-9a-fA-F]+$"},
          "replacement_hex": {"type": "string", "pattern": "^[0-9a-fA-F]+$"},
          "confidence": {"const": "high"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
