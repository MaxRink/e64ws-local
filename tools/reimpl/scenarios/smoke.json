{
  "id": "smoke",
  "title": "Standalone smoke test: 8 stock commands, dev gate, envelopes",
  "profile": "shipped",
  "reset": "pristine",
  "steps": [
    {"id": "s01", "op": "mark", "label": "stock-dispatchable direct commands"},
    {"id": "s02", "op": "wss", "type": "RequestDriverState", "msg_id": 1},
    {"id": "s03", "op": "assert", "source": "last_reply", "path": "type", "equals": "RequestDriverStateResult"},
    {"id": "s04", "op": "assert", "source": "last_reply", "path": "refId", "equals": 1},
    {"id": "s05", "op": "wss", "type": "RequestDriverConfig", "msg_id": 2},
    {"id": "s06", "op": "wss", "type": "RequestNachineInfo", "msg_id": 3},
    {"id": "s07", "op": "capture", "from": "last_reply", "path": "data.sessionId", "as": "session_id"},
    {"id": "s07b", "op": "assert", "source": "last_reply", "path": "data.sessionId", "equals_ref": "session_id"},
    {"id": "s08", "op": "wss", "type": "RequestOnboarding", "msg_id": 4, "data": {"token": "x"}},
    {"id": "s09", "op": "assert", "source": "last_reply", "path": "type", "equals": "RequestOnboardingResult"},
    {"id": "s10", "op": "assert", "source": "last_reply", "path": "refId", "absent": true},
    {"id": "s11", "op": "wss", "type": "WifiStaConfig", "msg_id": 5, "data": {"ssid": "Net", "password": "pw", "dhcp": true}},
    {"id": "s12", "op": "assert", "source": "last_reply", "path": "type", "equals": "WifiStaConfig"},
    {"id": "s13", "op": "wss", "type": "WifiConfigChanged", "msg_id": 6, "data": {"ssid": "Net"}},
    {"id": "s14", "op": "assert", "source": "last_reply", "path": "type", "equals": "WifiConfigChangedProcessed"},
    {"id": "s15", "op": "wss", "action": "EspReset", "msg_id": 7},
    {"id": "s16", "op": "wss", "action": "ResetDriverConfig", "msg_id": 8},
    {"id": "s17", "op": "mark", "label": "dev-gated command must close the socket"},
    {"id": "s18", "op": "wss", "action": "StartGrindGbw", "msg_id": 9, "data": {"targetWeightGr": 18.0}},
    {"id": "s19", "op": "mark", "label": "unknown type must close the socket"},
    {"id": "s20", "op": "wss", "type": "NoSuchCommand", "msg_id": 10},
    {"id": "s21", "op": "wss", "type": "RequestDriverState", "msg_id": 11, "token": false},
    {"id": "s22", "op": "http", "method": "POST", "path": "/rest_api/ping"},
    {"id": "s23", "op": "http", "method": "POST", "path": "/rest_api/login", "json": {"userRole": "Owner", "password": "e64-equivalence"}},
    {"id": "s24", "op": "http", "method": "POST", "path": "/rest_api/check_session", "session": true},
    {"id": "s25", "op": "http", "method": "POST", "path": "/rest_api/get_machine_info"},
    {"id": "s26", "op": "http", "method": "POST", "path": "/rest_api/download_machine_logs", "session": true, "binary_mode": "len"}
  ]
}
